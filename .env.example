APP_NAME=Scholargate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Web installer /install
# production: true HANYA saat setup pertama (atau re-install sadar), lalu false
# Setelah install sukses otomatis di-set false. local/testing boleh tanpa flag jika DB masih kosong.
ALLOW_INSTALL=true

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — pilih salah satu (default instalasi: pgsql)
# Installer: php artisan scholargate:install  ATAU  buka /install di browser
# ---------------------------------------------------------------------------

# PostgreSQL (default)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=scholargate
DB_USERNAME=postgres
DB_PASSWORD=

# MySQL / MariaDB (alternatif)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=scholargate
# DB_USERNAME=root
# DB_PASSWORD=

# SQLite (hanya dev cepat, tidak direkomendasikan production)
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Production: set SESSION_ENCRYPT=true and SESSION_SECURE_COOKIE=true (HTTPS)
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# Wajib production: r2 (Cloudflare R2 / S3-compatible). Dev tanpa R2 bisa public.
FILESYSTEM_DISK=r2
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@scholargate.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible) — pola sama twibbon-moklet / moklet-dev
# Semua unggahan media CMS wajib ke object storage ini di production.
# ---------------------------------------------------------------------------
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-bucket-name
R2_FOLDER_PATH=scholargate
R2_PUBLIC_URL=https://your-public-cdn-url.com
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_ACCESS_KEY=your_secret_key_here
R2_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=true

# Alias AWS (opsional, jika pakai S3 murni)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=true

# SPA stateful domains — tambahkan domain production (tanpa https://)
# Contoh: your-domain.sch.id,www.your-domain.sch.id,localhost,127.0.0.1:5173
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:5174,localhost:8000,localhost:8010,127.0.0.1,127.0.0.1:5173,127.0.0.1:5174,127.0.0.1:8000,127.0.0.1:8010
# Token API expire (menit). Default 14 hari. 0 = tidak pernah expire.
SANCTUM_TOKEN_EXPIRATION=20160

# Seed akun demo (ubah sebelum production / re-seed)
SEED_ADMIN_EMAIL=admin@scholargate.test
SEED_ADMIN_PASSWORD=Scholargate!Admin2026
SEED_MEMBER_EMAIL=member@scholargate.test
SEED_MEMBER_PASSWORD=Scholargate!Member2026
