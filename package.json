{
  "name": "cms-scholargate",
  "private": true,
  "type": "module",
  "description": "Scholargate CMS — Laravel + Inertia + React monolith",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "serve": "php artisan serve",
    "dev:all": "concurrently -c \"#93c5fd,#c4b5fd\" \"php artisan serve\" \"vite\" --names=php,vite",
    "install:app": "php artisan scholargate:install"
  },
